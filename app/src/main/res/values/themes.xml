<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ASDSMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/asds_gold</item>
        <item name="colorPrimaryVariant">@color/asds_gold_dark</item>
        <item name="colorOnPrimary">@color/asds_navy</item>
        <item name="colorSecondary">@color/asds_blue</item>
        <item name="colorSurface">@color/asds_surface</item>
        <item name="colorOnSurface">@color/asds_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/asds_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.ASDS.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/asds_gold_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ASDS.Pill</item>
    </style>

    <style name="ShapeAppearance.ASDS.Pill" parent="ShapeAppearance.Material3.Corner.Full" />
</resources>
